# ---------- Backend selection ----------
# local   -> SQLite + local Chroma (default, no cloud needed)
# bigquery -> BigQuery warehouse + (Chroma or BigQuery VECTOR_SEARCH)
BACKEND=local

# ---------- LLM ----------
# gemini | groq
LLM_PROVIDER=groq
GOOGLE_API_KEY=
GROQ_API_KEY=

# Model names (override if you like)
GEMINI_EXTRACT_MODEL=gemini-1.5-flash
GEMINI_ANSWER_MODEL=gemini-1.5-pro
GROQ_MODEL=llama-3.3-70b-versatile

# ---------- Speech-to-text ----------
# tiny | base | small | medium | large-v3  (laptop: use small; GPU: large-v3)
WHISPER_MODEL=small

# ---------- Translation (optional, best for Indian languages) ----------
SARVAM_API_KEY=

# ---------- Embeddings ----------
EMBEDDING_MODEL=BAAI/bge-m3

# ---------- Paths (local backend) ----------
LOCAL_DB_PATH=voc_local.db
CHROMA_DIR=./chroma
AUDIO_DIR=sample_data/calls

# ---------- Cloud (bigquery backend) ----------
GCP_PROJECT=
BQ_DATASET=voc
GCS_AUDIO_BUCKET=
GCS_TEMP_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
